    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P115"><text:soft-page-break/>Unterschlagene Kosten: <text:tab/>Millionen Tonnen CO₂ ohne 490-1.000€/t Folgekosten</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P72"/>
