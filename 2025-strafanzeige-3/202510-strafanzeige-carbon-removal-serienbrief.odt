    <text:list-item>
     <text:p text:style-name="P165">649,4 Mio. t CO₂ (nur strafbare Emissionen seit IPCC)</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P165">318,5-844,2 Mrd. € Carbon-Removal-Kosten</text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="P101" text:outline-level="2"/>
   <text:h text:style-name="P59" text:outline-level="2">Prognose: Weiterer Schuldenaufbau 2025-2030 (bei Weitermachen)</text:h>
   <text:h text:style-name="P70" text:outline-level="3">Annahmen für Projektion:</text:h>
   <text:list text:style-name="L61">
    <text:list-item>
     <text:p text:style-name="P166">Müllverbrennung: <text:tab/><text:tab/>Bleibt konstant 24 Mio. t CO₂/Jahr (sofort vermeidbar)</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P166">Kohlekraftwerke: <text:tab/><text:tab/>Abnehmend durch Kohleausstieg 2030 <text:tab/><text:tab/><text:tab/><text:tab/><text:tab/><text:tab/><text:tab/>(120→80→40→20→10→0 Mio. t)</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P166">Carbon-Removal-Preise: <text:tab/>Sinken langsam (1.000→800→600→500→400€/t bis 2030)</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P72"/>
