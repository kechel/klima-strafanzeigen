    <text:p text:style-name="P1"><text:span text:style-name="T1">Carbon-Removal Kosten</text:span><text:tab/><text:date style:data-style-name="N37" text:date-value="2025-11-28T10:59:05.428578369">28.11.25</text:date><text:tab/>Seite <text:page-number text:select-page="current">3</text:page-number><text:s/>von <text:page-count>3</text:page-count></text:p>
